{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=4410 HOST=127.0.0.1 RESEND_API_KEY=lhci-fake CONTACT_TO_EMAIL=lhci@example.com node scripts/lhci-server.mjs",
      "startServerReadyPattern": "lhci-proxy ready",
      "startServerReadyTimeout": 30000,
      "numberOfRuns": 3,
      "url": [
        "http://127.0.0.1:4410/",
        "http://127.0.0.1:4410/sermons",
        "http://127.0.0.1:4410/sermons/entrusted-with-resources-putting-money-in-its-place-2026-10-18",
        "http://127.0.0.1:4410/visit",
        "http://127.0.0.1:4410/entrusted"
      ]
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 300
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

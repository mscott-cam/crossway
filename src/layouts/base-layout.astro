---
import '@fontsource/libre-caslon-display/latin-400.css';
import '@fontsource/libre-caslon-text/latin-400.css';
import '@fontsource/libre-caslon-text/latin-400-italic.css';
import '@fontsource/hanken-grotesk/latin-400.css';
import '@fontsource/hanken-grotesk/latin-500.css';
import '@fontsource/hanken-grotesk/latin-600.css';
import '@fontsource/hanken-grotesk/latin-700.css';
import '../styles/global.css';
import displayFont from '@fontsource/libre-caslon-display/files/libre-caslon-display-latin-400-normal.woff2?url';
import uiFont from '@fontsource/hanken-grotesk/files/hanken-grotesk-latin-400-normal.woff2?url';
import { colors, tokensToCss } from '../lib/tokens';
import SiteHeader from '../components/site-header.astro';
import SiteFooter from '../components/site-footer.astro';
import QuestionsForm from '../components/questions-form.astro';
import AnnouncementBar from '../components/announcement-bar.astro';
import { getSiteSettings } from '../lib/sanity/queries';
import { site } from '../lib/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  bodyClass?: string;
  overHero?: boolean;
  noindex?: boolean;
  questions?: boolean;
}

const {
  title,
  description,
  ogImage,
  bodyClass,
  overHero = false,
  noindex = !site.indexable,
  questions = true,
} = Astro.props;

const speculationRules = JSON.stringify({
  prerender: [
    {
      where: {
        and: [
          { href_matches: '/*' },
          { not: { href_matches: '/api/*' } },
          { not: { selector_matches: '[target=_blank]' } },
        ],
      },
      eagerness: 'moderate',
    },
  ],
});
const settings = await getSiteSettings();
const siteName = 'Crossway Bible Church';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage ?? '/og/default.jpg', Astro.site).href;
const ogImageIsDefault = !ogImage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={colors.navy} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl} />
    {ogImageIsDefault && <meta property="og:image:width" content="1200" />}
    {ogImageIsDefault && <meta property="og:image:height" content="630" />}
    <meta
      property="og:image:alt"
      content={ogImageIsDefault ? siteName : title}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <link
      rel="preload"
      href={displayFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href={uiFont} as="font" type="font/woff2" crossorigin />
    <script type="speculationrules" is:inline set:html={speculationRules} />
    <slot name="head" />
    <style is:inline set:html={tokensToCss()}></style>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('reduced');
        }
      })();
    </script>
  </head>
  <body class={bodyClass} data-over-hero={overHero ? '' : undefined}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <AnnouncementBar announcement={settings.announcement} />
    {overHero ? (
      <div class="header-anchor">
        <SiteHeader overHero />
      </div>
    ) : (
      <SiteHeader />
    )}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {questions && <QuestionsForm />}
    <SiteFooter serviceTimes={settings.serviceTimes} />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style is:global>
  .header-anchor {
    position: relative;
    z-index: 50;
    flex: none;
    height: 0;
  }
</style>

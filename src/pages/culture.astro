---
import { getEntry } from 'astro:content';
import { z } from 'astro/zod';
import ProseLayout from '../layouts/prose-layout.astro';
import CultureValues from '../components/culture-values.astro';

const entry = await getEntry('pages', 'culture');
if (!entry) throw new Error('Missing content entry: pages/culture');
const { title, description, eyebrow } = entry.data;
const { mission, vision, commitmentsHeading, values } = z
  .object({
    mission: z.string(),
    vision: z.array(z.string()).min(1),
    commitmentsHeading: z.string(),
    values: z.array(z.object({ title: z.string(), verse: z.string() })).min(1),
  })
  .parse(entry.data);
---

<ProseLayout
  title={title}
  description={description}
  eyebrow={eyebrow}
  reveal={false}
>
  <section class="culture-block" data-reveal="fade" aria-labelledby="mission">
    <h2 id="mission">Mission</h2>
    <p class="culture-statement">{mission}</p>
  </section>

  <section class="culture-block" data-reveal="fade" aria-labelledby="vision">
    <h2 id="vision">Vision</h2>
    <p class="culture-statement">
      {vision.map((line, index) => (
        <>
          {index > 0 && <br />}
          {line}
        </>
      ))}
    </p>
  </section>

  <section
    class="culture-block"
    data-reveal="fade"
    aria-labelledby="commitments"
  >
    <h2 id="commitments">{commitmentsHeading}</h2>
    <CultureValues values={values} />
  </section>
</ProseLayout>

<style>
  .culture-block {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .culture-block:first-child {
    margin-top: 0;
  }

  .culture-block :global(h2) {
    margin: 0 0 1rem;
    font-size: var(--step-h3);
  }

  .culture-statement {
    margin: 0;
    color: var(--navy);
    font-family: var(--font-text);
    font-size: clamp(1.375rem, 1.15rem + 0.9vw, 1.875rem);
    font-style: italic;
    line-height: 1.4;
  }
</style>

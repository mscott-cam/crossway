---
interface Item {
  id?: string;
  question: string;
  answerHtml: string;
}

interface Props {
  items: readonly Item[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <div class="faq-list" data-faq-list>
    {items.map((item) => (
      <details class="faq-item" id={item.id} data-faq-item>
        <summary class="faq-question">
          <span class="faq-question__text">{item.question}</span>
          <span class="faq-question__mark" aria-hidden="true" />
        </summary>
        <div class="faq-answer prose" set:html={item.answerHtml} />
      </details>
    ))}
  </div>
)}

<style>
  .faq-list {
    border-top: 1px solid var(--rule);
  }

  .faq-item {
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 6rem;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 3.5rem;
    padding-block: 1rem;
    cursor: pointer;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question__text {
    color: var(--navy);
    font-family: var(--font-text);
    font-size: clamp(1.125rem, 1.03rem + 0.45vw, 1.375rem);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .faq-question__mark {
    position: relative;
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
    color: var(--amber-ink);
    transition: transform 0.25s ease;
  }

  .faq-question__mark::before,
  .faq-question__mark::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 2px;
    margin-top: -1px;
    background: currentColor;
  }

  .faq-question__mark::after {
    transform: rotate(90deg);
    transition: transform 0.25s ease;
  }

  .faq-item[open] > .faq-question .faq-question__mark {
    transform: rotate(180deg);
  }

  .faq-item[open] > .faq-question .faq-question__mark::after {
    transform: rotate(0deg);
  }

  .faq-question:focus-visible {
    outline: 2px solid var(--navy);
    outline-offset: 2px;
  }

  .faq-answer {
    padding-bottom: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-question__mark,
    .faq-question__mark::after {
      transition: none;
    }
  }
</style>

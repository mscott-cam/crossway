---
import Arrow from './arrow.astro';
import { site } from '../lib/site';

const steps = [
  {
    title: 'Connect',
    copy: 'We want to meet you!',
    label: 'Let’s connect',
    href: '/visit',
    external: false,
  },
  {
    title: 'Consider',
    copy: 'Learn more about us.',
    label: 'Tell me more',
    href: '/who-we-are',
    external: false,
  },
  {
    title: 'Commit',
    copy: 'Join our church!',
    label: 'I’m ready',
    href: site.links.churchCenter,
    external: true,
  },
];
---

<section class="steps on-navy" data-steps aria-labelledby="steps-title">
  <div class="container">
    <h2 class="eyebrow steps__label" id="steps-title" data-reveal="fade">
      Take your next step
    </h2>
    <ol class="steps__list">
      {steps.map((step, index) => (
        <li class="step" data-step data-reveal="fade">
          <span class="step__number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3 class="step__title">{step.title}</h3>
          <p class="step__copy">{step.copy}</p>
          <a
            class="step__link"
            href={step.href}
            target={step.external ? '_blank' : undefined}
            rel={step.external ? 'noopener noreferrer' : undefined}
          >
            {step.label}
            <Arrow />
            {step.external && (
              <span class="sr-only"> (opens in a new tab)</span>
            )}
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    padding-block: clamp(4rem, 8vw, 6.5rem);
  }

  .steps__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-block: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--paper) 18%, transparent);
  }

  .step__number {
    color: var(--amber);
    font-family: var(--font-text);
    font-size: 1.1875rem;
    font-style: italic;
    line-height: 1;
  }

  .step__title {
    margin-top: 1.25rem;
    font-size: var(--step-h2);
  }

  .step__copy {
    margin: 0.75rem 0 0;
    color: var(--mist);
    font-size: 1.3125rem;
  }

  .step__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
    min-height: 44px;
    overflow-wrap: anywhere;
    margin-top: 1.75rem;
    padding: 0.95rem 1.6rem;
    border: 0;
    border-radius: 999px;
    background: var(--amber);
    color: var(--navy);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s var(--ease-out);
  }

  .step__link:active {
    transform: scale(0.97);
  }

  .step__link:hover {
    background: color-mix(in srgb, var(--amber) 88%, var(--paper));
  }

  @media (min-width: 60rem) {
    .steps__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(2rem, 4vw, 4rem);
    }
  }
</style>

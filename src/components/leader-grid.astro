---
import { sanityImageUrl } from '../lib/image-url';
import { groupLeaders } from '../lib/leaders';
import type { Leader } from '../lib/sanity/types';

interface Props {
  leaders: readonly Leader[];
}

const { leaders } = Astro.props;
const sections = groupLeaders(leaders);
---

{sections.map((section) => (
  <section
    class="leader-section"
    data-leader-group={section.group}
    data-reveal="fade"
    aria-labelledby={`leaders-${section.group.toLowerCase().replace(/\s+/g, '-')}`}
  >
    <h2
      class="leader-section__title"
      id={`leaders-${section.group.toLowerCase().replace(/\s+/g, '-')}`}
    >
      {section.heading}
    </h2>
    <ul class="leader-list">
      {section.leaders.map((leader) => (
        <li class="leader" data-leader>
          {leader.photo && (
            <img
              class="leader__photo"
              src={sanityImageUrl(leader.photo.url, 240)}
              width={leader.photo.width}
              height={leader.photo.height}
              alt={leader.photo.alt ?? ''}
              loading="lazy"
              decoding="async"
            />
          )}
          <p class="leader__name">{leader.name}</p>
          {leader.role && <p class="leader__role">{leader.role}</p>}
        </li>
      ))}
    </ul>
  </section>
))}

<style>
  .leader-section {
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    border-top: 1px solid var(--rule);
  }

  .leader-section:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .leader-section__title {
    margin: 0 0 clamp(1.25rem, 3vw, 1.75rem);
    font-size: var(--step-h3);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .leader-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 1.5rem clamp(1.5rem, 4vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .leader {
    margin: 0;
  }

  .leader__photo {
    width: 4.5rem;
    height: 4.5rem;
    margin-bottom: 0.75rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .leader__name,
  .leader__role {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .leader__name {
    color: var(--navy);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.15;
  }

  .leader__role {
    margin-top: 0.3rem;
    color: var(--charcoal);
    font-size: 1rem;
    line-height: 1.4;
  }
</style>

---
import type { Book } from '../lib/books';
import type { Speaker } from '../lib/sanity/types';

interface Props {
  books: readonly Book[];
  speakers: readonly Speaker[];
  selectedBook?: string;
  selectedSpeaker?: string;
}

const { books, speakers, selectedBook, selectedSpeaker } = Astro.props;
---

<form class="sermon-filters" action="/sermons/filter" method="get">
  <div class="sermon-filters__field">
    <label for="filter-book">Book</label>
    <select id="filter-book" name="book">
      <option value="">All books</option>
      {books.map((book) => (
        <option value={book.slug} selected={book.slug === selectedBook}>
          {book.name}
        </option>
      ))}
    </select>
  </div>
  <div class="sermon-filters__field">
    <label for="filter-speaker">Speaker</label>
    <select id="filter-speaker" name="speaker">
      <option value="">All speakers</option>
      {speakers.map((speaker) => (
        <option
          value={speaker.slug}
          selected={speaker.slug === selectedSpeaker}
        >
          {speaker.name}
        </option>
      ))}
    </select>
  </div>
  <button type="submit" class="pill-navy">
    Filter
  </button>
</form>

<style>
  .sermon-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1rem 1.25rem;
  }

  .sermon-filters__field {
    display: grid;
    flex: 1 1 12rem;
    gap: 0.4rem;
    max-width: 18rem;
  }

  .sermon-filters label {
    color: var(--navy);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .sermon-filters select {
    width: 100%;
    min-height: 44px;
    padding: 0 0.875rem;
    border: 1px solid color-mix(in srgb, var(--navy) 35%, transparent);
    border-radius: 6px;
    background: var(--paper);
    color: var(--navy);
    font: inherit;
    font-size: 1.1875rem;
  }

  .sermon-filters .pill-navy {
    min-height: 44px;
    border: 0;
    cursor: pointer;
  }
</style>

---
import { getEntry, render } from 'astro:content';
import ProseLayout from '../layouts/prose-layout.astro';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const entry = await getEntry('pages', slug);
if (!entry) throw new Error(`Missing content entry: pages/${slug}`);
const { Content } = await render(entry);
const { title, description, eyebrow } = entry.data;
---

<ProseLayout title={title} description={description} eyebrow={eyebrow}>
  <Content />
</ProseLayout>

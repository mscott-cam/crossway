---
interface Props {
  poster: string;
  preloadPoster?: boolean;
  posterTime?: number;
}

const { poster, preloadPoster = false, posterTime = 3 } = Astro.props;
const base = poster.replace(/\/$/, '');
const dir = base.slice(0, base.lastIndexOf('/'));

const sources = [
  {
    src: `${dir}/lobby-720.webm`,
    type: 'video/webm',
    media: '(max-width: 800px)',
  },
  {
    src: `${dir}/lobby-720.mp4`,
    type: 'video/mp4',
    media: '(max-width: 800px)',
  },
  {
    src: `${dir}/lobby-1280.webm`,
    type: 'video/webm',
    media: '(min-width: 801px)',
  },
  {
    src: `${dir}/lobby-1280.mp4`,
    type: 'video/mp4',
    media: '(min-width: 801px)',
  },
];
---

{preloadPoster && (
  <link
    rel="preload"
    as="image"
    href={`${base}.avif`}
    type="image/avif"
    fetchpriority="high"
  />
)}
<div class="hero-video" data-hero-video>
  <picture>
    <source srcset={`${base}.avif`} type="image/avif" />
    <img
      src={`${base}.jpg`}
      alt=""
      width="1280"
      height="684"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
  <video
    muted
    playsinline
    loop
    preload="none"
    aria-hidden="true"
    tabindex="-1"
    disablepictureinpicture
    data-sources={JSON.stringify(sources)}
    data-start={posterTime > 0 ? String(posterTime) : undefined}
  ></video>
</div>

<script>
  import '../scripts/hero-video';
</script>

<style>
  .hero-video {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--navy);
  }

  .hero-video :is(picture, img, video) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-video video {
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  .hero-video.is-playing video {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video video {
      transition: none;
    }
  }
</style>

<style is:global>
  .hero-video-toggle {
    position: absolute;
    z-index: 3;
    bottom: 0.75rem;
    left: calc(max(0px, (100% - var(--container)) / 2) + var(--gutter));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--navy) 14%, transparent);
    border-radius: 50%;
    background: var(--paper);
    color: var(--navy);
    box-shadow: 0 8px 20px -10px rgba(0, 0, 0, 0.4);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .hero-video-toggle[hidden] {
    display: none;
  }

  .hero-video-toggle:hover {
    background: color-mix(in srgb, var(--paper) 90%, var(--navy));
  }

  .hero-video-toggle:focus-visible {
    outline: 2px solid var(--navy);
    outline-offset: 3px;
    box-shadow: 0 0 0 3px var(--paper);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-video-toggle {
      animation: hero-toggle-in 0.6s ease 0.8s both;
    }
  }

  @keyframes hero-toggle-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video-toggle {
      transition: none;
    }
  }
</style>

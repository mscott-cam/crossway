---
interface Props {
  poster: string;
  preloadPoster?: boolean;
}

const { poster, preloadPoster = false } = Astro.props;
const base = poster.replace(/\/$/, '');
const dir = base.slice(0, base.lastIndexOf('/'));

const sources = [
  {
    src: `${dir}/lobby-720.webm`,
    type: 'video/webm',
    media: '(max-width: 800px)',
  },
  {
    src: `${dir}/lobby-720.mp4`,
    type: 'video/mp4',
    media: '(max-width: 800px)',
  },
  {
    src: `${dir}/lobby-1280.webm`,
    type: 'video/webm',
    media: '(min-width: 801px)',
  },
  {
    src: `${dir}/lobby-1280.mp4`,
    type: 'video/mp4',
    media: '(min-width: 801px)',
  },
];
---

{preloadPoster && (
  <link
    rel="preload"
    as="image"
    href={`${base}.avif`}
    type="image/avif"
    fetchpriority="high"
  />
)}
<div class="hero-video" data-hero-video>
  <picture>
    <source srcset={`${base}.avif`} type="image/avif" />
    <img
      src={`${base}.jpg`}
      alt=""
      width="1280"
      height="684"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
  <video
    muted
    playsinline
    loop
    preload="none"
    aria-hidden="true"
    tabindex="-1"
    disablepictureinpicture
    data-sources={JSON.stringify(sources)}
  ></video>
</div>

<script>
  import '../scripts/hero-video';
</script>

<style>
  .hero-video {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--navy);
  }

  .hero-video :is(picture, img, video) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-video video {
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  .hero-video.is-playing video {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video video {
      transition: none;
    }
  }
</style>

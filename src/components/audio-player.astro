---
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
---

<div class="audio-player" data-audio-player data-src={src} data-title={title}>
  <audio controls preload="none" src={src} aria-label={title}></audio>
  <div class="audio-player__ui">
    <div class="audio-player__controls">
      <button
        type="button"
        class="audio-player__button audio-player__button--play"
        data-play
        aria-label="Play"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
        </svg>
      </button>
      <button type="button" class="audio-player__button" data-back>
        −15<span class="sr-only"> seconds, back</span>
      </button>
      <button type="button" class="audio-player__button" data-forward>
        +15<span class="sr-only"> seconds, forward</span>
      </button>
      <span class="audio-player__spacer"></span>
      <button type="button" class="audio-player__button" data-speed>
        <span class="sr-only">Playback speed </span>
        <span data-speed-value>1×</span>
      </button>
    </div>
    <div class="audio-player__timeline">
      <span class="audio-player__time" data-elapsed>
        0:00
      </span>
      <input
        class="audio-player__scrubber"
        type="range"
        min="0"
        max="0"
        step="1"
        value="0"
        disabled
        data-scrubber
        aria-label={`Seek: ${title}`}
      />
      <span class="audio-player__time" data-total>
        –:––
      </span>
    </div>
    <p class="audio-player__message" role="status"></p>
    <span class="sr-only" role="status" aria-live="polite" data-announce></span>
  </div>
</div>

<script>
  import '../scripts/audio-player';
</script>

<style is:global>
  .audio-player {
    position: relative;
    padding: 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--paper);
    color: var(--navy);
    font-family: var(--font-ui);
  }

  .audio-player:not(.is-ready) .audio-player__ui {
    visibility: hidden;
  }

  .audio-player:not(.is-ready) audio {
    position: absolute;
    top: 50%;
    left: 1.25rem;
    width: calc(100% - 2.5rem);
    transform: translateY(-50%);
  }

  .audio-player.is-ready audio {
    display: none;
  }

  .audio-player__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .audio-player__spacer {
    flex: 1 1 0;
  }

  .audio-player__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.875rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--navy);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .audio-player__button:hover {
    background: color-mix(in srgb, var(--navy) 8%, transparent);
  }

  .audio-player__button--play {
    width: 56px;
    height: 56px;
    padding: 0;
    border-color: var(--navy);
    background: var(--navy);
    color: var(--paper);
  }

  .audio-player__button--play:hover {
    background: color-mix(in srgb, var(--navy) 85%, var(--charcoal));
  }

  .audio-player__button svg {
    width: 22px;
    height: 22px;
  }

  .audio-player__timeline {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .audio-player__time {
    min-width: 3.5ch;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    color: var(--charcoal);
  }

  .audio-player__scrubber {
    width: 100%;
    min-height: 44px;
    margin: 0;
    accent-color: var(--navy);
    cursor: pointer;
  }

  .audio-player__scrubber:disabled {
    cursor: default;
    opacity: 0.55;
  }

  .audio-player__message {
    margin: 0.5rem 0 0;
    color: var(--charcoal);
    font-size: 0.875rem;
  }

  .audio-player__message:empty {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  @media (max-width: 30rem) {
    .audio-player {
      padding: 0.875rem;
    }

    .audio-player:not(.is-ready) audio {
      left: 0.875rem;
      width: calc(100% - 1.75rem);
    }

    .audio-player__controls {
      gap: 0.375rem;
    }

    .audio-player__button {
      padding: 0 0.625rem;
    }

    .audio-player__timeline {
      gap: 0.5rem;
    }
  }
</style>

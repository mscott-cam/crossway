---
import HeroVideo from './hero-video.astro';
import { HERO_POSTER } from '../lib/video/hero-poster';
---

<div class="hero-stage">
  <div class="hero-stage__inner">
    <section class="hero" data-hero aria-labelledby="home-title">
      <div class="hero__media">
        <HeroVideo poster={HERO_POSTER} />
      </div>
      <div class="hero__wash" aria-hidden="true"></div>
      <div class="container hero__inner">
        <p class="eyebrow" data-reveal="fade" data-reveal-delay="0.15">
          Crossway Bible Church · San Antonio
        </p>
        <h1
          class="display-hero hero__title"
          id="home-title"
          data-reveal="lines"
        >
          <span class="hero__line">You are</span>{' '}
          <span class="hero__line">
            <em>loved.</em>
          </span>
        </h1>
        <p class="hero__verse" data-reveal="fade" data-reveal-delay="0.4">
          “We love because he first loved us.”
          <span class="verse-cite">1 John 4:19</span>
        </p>
      </div>
    </section>
    <div class="hero-stage__card">
      <slot />
    </div>
  </div>
</div>

<style>
  .hero-stage {
    container-type: inline-size;
  }

  .hero-stage__inner {
    position: relative;
  }

  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: clamp(34rem, 86svh, 47rem);
    padding-block: 8rem max(clamp(3rem, 6vw, 4.5rem), 4.25rem);
    overflow: clip;
    background: var(--paper);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__media {
      animation: hero-settle 1.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.05);
    }
    to {
      transform: scale(1);
    }
  }

  .hero__wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--paper) 96%, transparent) 0%,
        color-mix(in srgb, var(--paper) 88%, transparent) 30%,
        color-mix(in srgb, var(--paper) 58%, transparent) 50%,
        color-mix(in srgb, var(--paper) 22%, transparent) 70%,
        color-mix(in srgb, var(--paper) 0%, transparent) 90%
      ),
      linear-gradient(
        0deg,
        var(--paper) 0%,
        color-mix(in srgb, var(--paper) 70%, transparent) 10%,
        color-mix(in srgb, var(--paper) 0%, transparent) 38%
      );
  }

  .hero__inner {
    position: relative;
    z-index: 2;
  }

  .hero__title {
    margin-top: 1.5rem;
  }

  .hero__line {
    display: block;
    padding-bottom: 0.08em;
  }

  .hero__verse {
    max-width: 30ch;
    margin: 2rem 0 0;
    color: color-mix(in srgb, var(--navy) 82%, var(--charcoal));
    font-family: var(--font-text);
    font-size: clamp(1.3125rem, 1.15rem + 0.6vw, 1.625rem);
    font-style: italic;
    line-height: 1.45;
  }

  .hero__verse .verse-cite {
    display: block;
    margin-top: 0.6rem;
    font-style: normal;
  }

  .hero-stage__card {
    padding: 1.5rem var(--gutter) 3rem;
  }

  @container (max-width: 40rem) {
    .hero__title {
      font-size: clamp(
        min(4rem, 20vw),
        min(29vw, (100vw - 2 * var(--gutter)) / 3),
        8rem
      );
    }

    .hero .eyebrow {
      gap: 0.75rem;
      letter-spacing: 0.18em;
    }

    .hero .eyebrow::before {
      width: 24px;
    }

    .hero__wash {
      background:
        linear-gradient(
          90deg,
          color-mix(in srgb, var(--paper) 94%, transparent) 0%,
          color-mix(in srgb, var(--paper) 84%, transparent) 60%,
          color-mix(in srgb, var(--paper) 52%, transparent) 100%
        ),
        linear-gradient(
          0deg,
          color-mix(in srgb, var(--paper) 70%, transparent) 0%,
          color-mix(in srgb, var(--paper) 0%, transparent) 35%
        );
    }
  }

  @container (min-width: 68.75rem) {
    .hero-stage__inner {
      display: flex;
      flex-direction: column;
      min-height: calc(100svh - var(--announcement-h, 0px));
    }

    .hero {
      flex: 1 0 auto;
      min-height: 30rem;
    }

    .hero-stage__card {
      max-width: var(--container);
      margin-inline: auto;
      padding-block: 2.25rem 2.5rem;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-announcement]');
  if (bar) {
    const root = document.documentElement;
    const sync = () =>
      root.style.setProperty('--announcement-h', `${bar.offsetHeight}px`);
    sync();
    new ResizeObserver(sync).observe(bar);
  }
</script>

---
import Eyebrow from './eyebrow.astro';
import ContactFallback from './contact-fallback.astro';

const siteKey = (
  process.env.TURNSTILE_SITE_KEY ??
  import.meta.env.TURNSTILE_SITE_KEY ??
  ''
).trim();
const publicEmail = (
  process.env.CONTACT_PUBLIC_EMAIL ??
  import.meta.env.CONTACT_PUBLIC_EMAIL ??
  ''
).trim();
const returnTo = Astro.url.pathname;
---

<section
  id="questions"
  class="questions"
  aria-labelledby="questions-heading"
  data-sitekey={siteKey || undefined}
>
  <div class="container">
    <div class="questions__inner">
      <div class="questions__intro">
        <Eyebrow>Questions &amp; Prayer</Eyebrow>
        <h2 id="questions-heading">Have questions? Need prayer?</h2>
        <p class="questions__lede">
          Ask us anything about Crossway, or let us know how we can pray for
          you.
        </p>
      </div>

      <div class="questions__main">
        <div
          id="questions-sent"
          class="questions__result"
          role="status"
          data-result="sent"
        >
          <p>Thank you! We'll get back to you soon.</p>
        </div>
        <div
          id="questions-error"
          class="questions__result questions__result--error"
          role="status"
          data-result="error"
        >
          <p data-failure-copy>
            Something went wrong sending your message. Please try again, or
            email us directly.
          </p>
          <div data-fallback>
            <ContactFallback email={publicEmail} />
          </div>
        </div>

        <form
          class="questions__form"
          method="post"
          action="/api/contact"
          data-contact-form
        >
          <input type="hidden" name="returnTo" value={returnTo} />

          <div class="questions__row">
            <div class="questions__field">
              <label for="questions-name">Name</label>
              <input
                id="questions-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                maxlength="100"
                aria-describedby="questions-name-error"
              />
              <p class="questions__error" id="questions-name-error" hidden></p>
            </div>
            <div class="questions__field">
              <label for="questions-email">Email</label>
              <input
                id="questions-email"
                name="email"
                type="email"
                autocomplete="email"
                required
                maxlength="254"
                aria-describedby="questions-email-error"
              />
              <p class="questions__error" id="questions-email-error" hidden></p>
            </div>
          </div>

          <div class="questions__field">
            <label for="questions-heard">How'd you hear about us?</label>
            <input
              id="questions-heard"
              name="heardFrom"
              type="text"
              autocomplete="off"
              maxlength="200"
              aria-describedby="questions-heardFrom-error"
            />
            <p
              class="questions__error"
              id="questions-heardFrom-error"
              hidden
            ></p>
          </div>

          <div class="questions__field">
            <label for="questions-message">Question // Prayer Request</label>
            <textarea
              id="questions-message"
              name="message"
              rows="5"
              required
              maxlength="5000"
              aria-describedby="questions-message-error"
            ></textarea>
            <p class="questions__error" id="questions-message-error" hidden></p>
          </div>

          <div class="questions__trap" aria-hidden="true">
            <label for="questions-extra-note">Leave this field empty</label>
            <input
              id="questions-extra-note"
              name="contact_extra_note"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          {siteKey && <div class="questions__turnstile" data-turnstile-mount />}

          <div class="questions__actions">
            <button class="pill-navy questions__send" type="submit">
              Send
            </button>
            <div class="questions__status" role="status" data-status></div>
          </div>
          <noscript>
            <div class="questions__noscript">
              <p>
                Without JavaScript, our spam check may stop this message from
                sending.
              </p>
              <ContactFallback email={publicEmail} />
            </div>
          </noscript>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/contact-form';
</script>

<style>
  .questions {
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .questions__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    border-top: 1px solid var(--rule);
  }

  .questions__intro h2 {
    margin-top: 1rem;
    font-size: var(--step-h3);
    line-height: 1.1;
  }

  .questions__lede {
    max-width: 30ch;
    margin: 1rem 0 0;
    font-size: 1.0625rem;
  }

  .questions__main {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
    align-content: start;
  }

  .questions__result {
    display: none;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--navy);
    background: color-mix(in srgb, white 55%, var(--paper));
    color: var(--navy);
    font-weight: 500;
    scroll-margin-top: 6rem;
  }

  .questions__result p {
    margin: 0;
  }

  .questions__result p + * {
    margin-top: 0.75rem;
  }

  .questions__result--error {
    border-left-color: var(--error);
    color: var(--error);
  }

  .questions__result--error [data-fallback] {
    color: var(--charcoal);
  }

  :global(html:not(.form-ready)) .questions__result:target {
    display: block;
  }

  .questions__noscript {
    display: grid;
    gap: 0.75rem;
    font-size: 0.9375rem;
  }

  .questions__noscript p {
    margin: 0;
  }

  .questions__form {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }

  .questions__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: 1.25rem;
  }

  .questions__field {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  .questions__field label {
    color: var(--navy);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .questions__field input,
  .questions__field textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--navy) 62%, var(--paper));
    border-radius: 8px;
    background: color-mix(in srgb, white 55%, var(--paper));
    color: var(--charcoal);
    font: inherit;
    font-size: 1rem;
    line-height: 1.5;
    transition: border-color 0.2s ease;
  }

  .questions__field textarea {
    min-height: 9rem;
    resize: vertical;
  }

  .questions__field input:hover,
  .questions__field textarea:hover {
    border-color: var(--navy);
  }

  .questions__field input:focus-visible,
  .questions__field textarea:focus-visible {
    outline: 2px solid var(--navy);
    outline-offset: 2px;
    border-color: var(--navy);
  }

  .questions__field input[aria-invalid='true'],
  .questions__field textarea[aria-invalid='true'] {
    border-color: var(--error);
    border-width: 2px;
  }

  .questions__error {
    margin: 0;
    color: var(--error);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .questions__error[hidden] {
    display: none;
  }

  .questions__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .questions__actions {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    margin-top: 0.25rem;
  }

  .questions__send {
    min-height: 3rem;
    padding-inline: 2.25rem;
    border: 0;
    cursor: pointer;
  }

  .questions__send[aria-disabled='true'] {
    opacity: 0.65;
    cursor: progress;
  }

  .questions__status {
    min-height: 4.5em;
    margin: 0;
    color: var(--navy);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .questions__status[data-state='error'] {
    color: var(--error);
  }

  .questions__status p {
    margin: 0;
  }

  .questions__status p + * {
    margin-top: 0.5rem;
  }

  .questions__status [data-fallback] {
    color: var(--charcoal);
  }

  @media (min-width: 40rem) {
    .questions__status {
      min-height: 3em;
    }
  }

  @media (min-width: 60rem) {
    .questions__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .questions__field input,
    .questions__field textarea {
      transition: none;
    }
  }
</style>

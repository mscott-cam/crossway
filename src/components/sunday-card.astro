---
import Arrow from './arrow.astro';
import { serviceTimeParts } from '../lib/format-times';
import { safeHref } from '../lib/safe-href';
import type { SiteSettings } from '../lib/sanity/types';

interface Props {
  settings: Pick<SiteSettings, 'serviceTimes' | 'sundayCardRows'>;
}

const { settings } = Astro.props;
const parts = serviceTimeParts(settings.serviceTimes);
const rows = settings.sundayCardRows.map((row) => {
  const href = safeHref(row.href);
  return {
    ...row,
    href,
    external: Boolean(href && /^https?:\/\//i.test(href)),
  };
});
---

<aside
  class="sunday-card on-navy"
  data-sunday-card
  data-reveal="up"
  data-reveal-delay="0.3"
  aria-labelledby="sunday-card-title"
>
  <div class="sunday-card__head">
    <h2 class="eyebrow sunday-card__label" id="sunday-card-title">
      <span class="sunday-card__dot" aria-hidden="true"></span>This Sunday
    </h2>
    {parts.length > 0 && (
      <p class="sunday-card__times" data-sunday-times>
        {parts.map((part) =>
          part.kind === 'separator' ? (
            <span class="sunday-card__sep">{part.text}</span>
          ) : part.kind === 'meridiem' ? (
            <span class="sunday-card__meridiem">{part.text}</span>
          ) : (
            <span class="sunday-card__time">{part.text}</span>
          ),
        )}
      </p>
    )}
  </div>
  {rows.length > 0 && (
    <dl class="sunday-card__rows">
      {rows.map((row) => (
        <div class="sunday-card__row">
          <dt>{row.label}</dt>
          <dd>
            {row.href ? (
              <a
                href={row.href}
                target={row.external ? '_blank' : undefined}
                rel={row.external ? 'noopener noreferrer' : undefined}
              >
                {row.value}
                <Arrow />
                {row.external && (
                  <span class="sr-only"> (opens in a new tab)</span>
                )}
              </a>
            ) : (
              row.value
            )}
          </dd>
        </div>
      ))}
    </dl>
  )}
  <a class="sunday-card__go" href="/visit">
    Plan your visit
    <Arrow />
  </a>
</aside>

<style>
  .sunday-card {
    display: flex;
    flex-direction: column;
    max-width: 100%;
    padding: 1.875rem 2rem 1.75rem;
    border-radius: 22px;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.45);
  }

  .sunday-card__label {
    gap: 0.6rem;
  }

  .sunday-card__label::before {
    display: none;
  }

  .sunday-card__dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--amber);
  }

  .sunday-card__times {
    margin: 1rem 0 0;
    color: var(--paper);
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 2.1rem + 2.6vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  .sunday-card__time {
    white-space: nowrap;
  }

  .sunday-card__sep {
    color: var(--mist);
    font-family: var(--font-text);
    font-size: 0.42em;
    font-style: italic;
    letter-spacing: 0;
  }

  .sunday-card__meridiem {
    color: var(--mist);
    font-family: var(--font-ui);
    font-size: max(1rem, 0.2em);
    font-weight: 600;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .sunday-card__rows {
    margin: 1.25rem 0 0;
    border-top: 1px solid color-mix(in srgb, var(--paper) 15%, transparent);
  }

  .sunday-card__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.15rem 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 15%, transparent);
    font-size: 1.125rem;
    line-height: 1.45;
  }

  .sunday-card__row dt {
    color: var(--paper);
    font-weight: 600;
  }

  .sunday-card__row dd {
    margin: 0;
    margin-left: auto;
    color: color-mix(in srgb, var(--paper) 80%, var(--mist));
    text-align: right;
    text-wrap: balance;
  }

  .sunday-card__row dd a {
    color: var(--amber);
    text-decoration: none;
  }

  .sunday-card__row dd a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .sunday-card__go {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.25rem;
    padding: 0.95rem 1.4rem;
    border-radius: 999px;
    background: var(--amber);
    color: var(--navy);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 0.2s ease,
      transform 0.2s var(--ease-out);
  }

  .sunday-card__go:hover {
    background: color-mix(in srgb, var(--amber) 88%, var(--paper));
  }

  .sunday-card__go:active {
    transform: scale(0.97);
  }

  .sunday-card__go:focus-visible {
    outline-color: var(--paper);
  }

  @container (max-width: 19.9rem) {
    .sunday-card {
      padding-inline: 1.25rem;
    }

    .sunday-card__times {
      font-size: min(clamp(2.75rem, 2.1rem + 2.6vw, 4rem), 14vw);
    }
  }

  @container (min-width: 40rem) and (max-width: 68.74rem) {
    .sunday-card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'head rows'
        'go rows';
      gap: 1.5rem 3rem;
      align-items: start;
      padding: 2.25rem 2.5rem;
    }

    .sunday-card__head {
      grid-area: head;
    }

    .sunday-card__rows {
      grid-area: rows;
      align-self: end;
      margin-top: 0;
    }

    .sunday-card__go {
      grid-area: go;
      align-self: end;
      margin-top: 0;
    }
  }

  @container (min-width: 68.75rem) {
    .sunday-card {
      flex-direction: row;
      align-items: stretch;
      gap: 1.25rem 1.5rem;
      padding: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      color: var(--navy);
      --focus: var(--navy);
    }

    .sunday-card .sunday-card__label {
      color: var(--amber-ink);
    }

    .sunday-card__times {
      margin-top: 0.5rem;
      color: var(--navy);
      font-size: clamp(2.25rem, 1.25rem + 2vw, 3rem);
    }

    .sunday-card__sep,
    .sunday-card__meridiem {
      color: color-mix(in srgb, var(--navy) 80%, var(--paper));
    }

    .sunday-card__rows {
      display: flex;
      flex: 1 1 0;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 0;
      min-width: 0;
      margin: 0;
      border-top: 0;
    }

    .sunday-card__row {
      display: block;
      flex: 0 1 auto;
      min-width: 0;
      padding: 0 1.25rem;
      border-bottom: 0;
      border-left: 1px solid var(--rule);
      font-size: 1.0625rem;
      line-height: 1.4;
    }

    .sunday-card__row:nth-child(2) {
      flex: 1 1 auto;
    }

    .sunday-card__row:not(:nth-child(2)) {
      min-width: max-content;
    }

    .sunday-card__row dt {
      color: color-mix(in srgb, var(--navy) 80%, var(--paper));
      font-size: 0.9375rem;
      line-height: 1.4;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .sunday-card__row dd {
      margin: 0.6rem 0 0;
      color: var(--navy);
      text-align: left;
      text-wrap: balance;
    }

    .sunday-card__row:not(:nth-child(2)) dd {
      white-space: nowrap;
    }

    .sunday-card__row dd a {
      color: var(--navy);
      font-weight: 500;
    }

    .sunday-card__head {
      flex: none;
    }

    .sunday-card__go {
      flex: none;
      align-self: center;
      gap: 0.75rem;
      margin-top: 0;
      padding-inline: 1.25rem;
    }

    .sunday-card__go:focus-visible {
      outline-color: var(--navy);
    }
  }
</style>

---
import Arrow from './arrow.astro';
---

<section
  class="entrusted"
  data-entrusted-feature
  aria-labelledby="entrusted-title"
>
  <div class="container entrusted__inner" data-reveal="fade">
    <div class="entrusted__head">
      <p class="eyebrow">Entrusted</p>
      <h2 class="entrusted__title" id="entrusted-title">
        With much, <em>for more.</em>
      </h2>
    </div>
    <div class="entrusted__body">
      <p>
        Entrusted is a one-fund, two-year, church-wide initiative, from December
        2026 to December 2028. Every gift given to Crossway goes to Existing
        disciple-making, Expanding disciple-making, and Extending
        disciple-making.
      </p>
      <p class="entrusted__more">
        <a class="pill-navy entrusted__link" href="/entrusted">
          Learn about Entrusted
          <Arrow />
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .entrusted {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: color-mix(in srgb, var(--amber) 10%, var(--paper));
  }

  .entrusted__inner {
    display: grid;
    gap: 1.75rem clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .entrusted__title {
    margin-top: 1.25rem;
    font-size: var(--step-h2);
    text-wrap: balance;
  }

  .entrusted__title em {
    display: inline-block;
    padding-left: 0.08em;
  }

  .entrusted__body p:first-child {
    max-width: 46ch;
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.6;
  }

  .entrusted__more {
    margin: 2rem 0 0;
  }

  .entrusted__link {
    gap: 0.75rem;
    min-height: 3.25rem;
    padding-inline: 1.75rem;
  }

  @media (min-width: 60rem) {
    .entrusted__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .entrusted__body {
      padding-top: 2.5rem;
    }
  }
</style>

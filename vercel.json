{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "build": { "env": { "ALLOW_EMPTY_CONTENT": "1" } },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "crons": [{ "path": "/api/cron/rebuild", "schedule": "0 11 * * *" }]
}

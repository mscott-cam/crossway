# Copy to .env for local work. In Vercel, set these under Project, Settings, Environment Variables.
# BUILD variables are read while the site builds (change one, redeploy). RUNTIME variables are read by server routes on each request.
# See "Environment variables" in README.md for the full table.

# BUILD. Required for a Vercel Production build: without a real project id the build FAILS (set ALLOW_EMPTY_CONTENT=1 to deploy an empty site on purpose). Preview and local builds only warn.
SANITY_PROJECT_ID=
# BUILD. Defaults to production.
SANITY_DATASET=
# BUILD. Only needed if the dataset is private.
SANITY_API_READ_TOKEN=

# BUILD. Planning Center personal access token. Unset: /events shows its empty state and the build logs a [events] warning.
PCO_APP_ID=
PCO_SECRET=

# Contact form. RUNTIME. In production the form answers 503 unless RESEND_API_KEY, CONTACT_TO_EMAIL, CONTACT_FROM_EMAIL and TURNSTILE_SECRET_KEY are all set.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be an address on the verified Resend domain.
CONTACT_FROM_EMAIL=
# BUILD, not secret. Owner-supplied public address shown in the form's failure and no-JavaScript text. Leave empty until the church provides one.
CONTACT_PUBLIC_EMAIL=
# Cloudflare Turnstile. TURNSTILE_SITE_KEY is BUILD: set it in the Vercel build environment and redeploy after changing it. Without it no widget mounts. Restrict the widget to the production hostnames in the Cloudflare dashboard.
TURNSTILE_SITE_KEY=
# RUNTIME.
TURNSTILE_SECRET_KEY=
# There is no rate limiting and no Origin check beyond Turnstile, the honeypot and the 20 KB body cap.

# Daily rebuild cron (Production only). RUNTIME.
VERCEL_DEPLOY_HOOK_URL=
CRON_SECRET=

# Escape hatch: 1 downgrades the production no-content build failure to a warning. Leave unset.
ALLOW_EMPTY_CONTENT=

# Local use only, never set in Vercel: write token for scripts/import-webflow.ts (see scripts/README-import.md).
SANITY_API_WRITE_TOKEN=

# Test-only, never set in Vercel: E2E, SANITY_FIXTURES, SANITY_FIXTURE_SETTINGS, SANITY_FIXTURE_DIR, PCO_FIXTURE_FILE, CROSSWAY_CACHE_DIR.
# Use the npm scripts (build:e2e, test:e2e) instead of setting them by hand.

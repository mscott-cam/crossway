SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_READ_TOKEN=
PCO_APP_ID=
PCO_SECRET=
# Contact form. Runtime (Vercel Production environment variables).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be an address on the verified Resend domain; required in production.
CONTACT_FROM_EMAIL=
# Owner-supplied public address shown in the form's failure and no-JavaScript text. BUILD-time, not secret; leave empty until the church provides one.
CONTACT_PUBLIC_EMAIL=
# Cloudflare Turnstile. TURNSTILE_SITE_KEY is read at BUILD time by the static pages: set it in the Vercel build environment and redeploy after changing it. Without it no widget mounts and every submission fails verification once the secret is set. Restrict the widget to the production hostnames in the Cloudflare dashboard.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# There is no rate limiting and no Origin check beyond Turnstile, the honeypot and the 20 KB body cap.
VERCEL_DEPLOY_HOOK_URL=
CRON_SECRET=
